// ======================================================
// BOUND DSL Grammar v2.2
// ======================================================

start: policy_decl metric_decl* rule_decl+

policy_decl: "POLICY" IDENTIFIER

metric_decl: "METRIC" IDENTIFIER metric_type

metric_type: NUMBER_TYPE | PERCENT_TYPE | STATUS_TYPE

NUMBER_TYPE: "NUMBER"
PERCENT_TYPE: "PERCENT"
STATUS_TYPE: "STATUS"

rule_decl: "RULE" IDENTIFIER when_clause then_clause+

when_clause: "WHEN" condition

condition: IDENTIFIER comparator value

comparator: GT | LT | GTE | LTE | EQ

GT: ">"
LT: "<"
GTE: ">="
LTE: "<="
EQ: "=="

then_clause: "THEN" action

action: emit_action | execute_action

emit_action: "EMIT" IDENTIFIER

execute_action: "EXECUTE" IDENTIFIER

value: NUMBER | STRING | IDENTIFIER

IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

STRING: /"[^"]*"/

NUMBER: /[0-9]+(\.[0-9]+)?/

COMMENT: /#[^\n]*/

%import common.WS
%import common.NEWLINE

%ignore WS
%ignore NEWLINE
%ignore COMMENT